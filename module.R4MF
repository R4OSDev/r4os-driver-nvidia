R4OS_MODULE_MANIFEST=2
KIND=R4D
NAME=NVIDIA
VERSION=0.1.26
LANGUAGE=Zig
SOURCE=src/main.zig
SOURCE=src/rm/os_memory.c
SOURCE=src/rm/nvkms_memory.c
SOURCE=src/rm/os_clock.c
SOURCE=src/rm/nvkms_clock.c
SOURCE=src/rm/cpu_probe.c
SOURCE=src/rm/os_semaphore.c
SOURCE=src/rm/nvkms_semaphore.c
SOURCE=src/rm/semaphore_probe.c
SOURCE=src/rm/os_wait.c
SOURCE=src/rm/nvkms_wait.c
SOURCE=src/rm/wait_probe.c
SOURCE=src/rm/os_format.c
SOURCE=src/rm/nvkms_format.c
SOURCE=src/rm/os_log.c
SOURCE=src/rm/nvkms_log.c
C_INCLUDE=ThirdParty/Nvidia570.144/src/common/sdk/nvidia/inc
C_INCLUDE=ThirdParty/Nvidia570.144/src/nvidia/arch/nvalloc/unix/include
C_INCLUDE=ThirdParty/Nvidia570.144/src/nvidia/inc
C_INCLUDE=ThirdParty/Nvidia570.144/src/nvidia/inc/kernel
C_INCLUDE=ThirdParty/Nvidia570.144/src/nvidia-modeset/os-interface/include
C_INCLUDE=ThirdParty/Nvidia570.144/src/nvidia-modeset/kapi/interface
C_INCLUDE=ThirdParty/Nvidia570.144/src/nvidia-modeset/interface
C_DEFINE=NV_UNIX=1
C_DEFINE=NV_R4OS=1
C_DEFINE=NV_X86_64=1
C_DEFINE=NV_ARCH_BITS=64
C_FLAG=-std=gnu11
C_FLAG=-g0
C_FLAG=-fno-strict-aliasing
C_FLAG=-fno-common
C_FLAG=-mno-mmx
C_FLAG=-mno-sse
C_FLAG=-mno-sse2
C_FLAG=-mno-avx
C_FLAG=-mno-avx2
TARGET=/R4OS/DRIVERS/NVIDIA.R4D
IMAGE_SCOPE=none
IMPORT=R4DEV:Query:1
RESOURCE=NVFW-LOCK.json:src/firmware-lock.json
RESOURCE=NVIDIA-570.144-HEADERS-LICENSE.txt:ThirdParty/Nvidia570.144/LICENSES.txt
RESOURCE=NVIDIA-570.144-LICENSE.txt:Firmware/NVIDIA-570.144-LICENSE.txt
RESOURCE=GSP-570.144-GA10X.bin:Firmware/GSP-570.144-GA10X.bin
RESOURCE=GSP-570.144-TU10X.bin:Firmware/GSP-570.144-TU10X.bin
RESOURCE=GSP-570.144-GA102-BOOT.bin:BootFirmware/GSP-570.144-GA102-BOOT.bin
RESOURCE=GSP-570.144-GA102-BOOT-DESC.bin:BootFirmware/GSP-570.144-GA102-BOOT-DESC.bin
RESOURCE=NVIDIA-570.144-GSP-BOOT-LICENSE.txt:BootFirmware/NVIDIA-570.144-GSP-BOOT-LICENSE.txt
META=r4d.name=NVIDIA
META=r4d.type=display
META=module.name=R4D_NVIDIA
